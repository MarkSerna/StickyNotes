<Application
    x:Class="StickyNotes.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFF7F7F7" />
                    <SolidColorBrush x:Key="AppHeaderBrush" Color="#FFF3F3F3" />
                    <SolidColorBrush x:Key="AppSubtleSurfaceBrush" Color="#FFECECEC" />
                    <SolidColorBrush x:Key="AppTextBrush" Color="#FF1A1A1A" />
                    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#FF5F6368" />
                    <SolidColorBrush x:Key="AppIconBrush" Color="#FF3B3B3B" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#FFD2D2D2" />
                    <SolidColorBrush x:Key="AppDividerBrush" Color="#26000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FF1A1A1A" />
                    <SolidColorBrush x:Key="AppHeaderBrush" Color="#FF252525" />
                    <SolidColorBrush x:Key="AppSubtleSurfaceBrush" Color="#FF2A2A2A" />
                    <SolidColorBrush x:Key="AppTextBrush" Color="#FFF0F0F0" />
                    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#FFA9A9A9" />
                    <SolidColorBrush x:Key="AppIconBrush" Color="#FFE0E0E0" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#FF3A3A3A" />
                    <SolidColorBrush x:Key="AppDividerBrush" Color="#25FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FF1A1A1A" />
                    <SolidColorBrush x:Key="AppHeaderBrush" Color="#FF252525" />
                    <SolidColorBrush x:Key="AppSubtleSurfaceBrush" Color="#FF2A2A2A" />
                    <SolidColorBrush x:Key="AppTextBrush" Color="#FFF0F0F0" />
                    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#FFA9A9A9" />
                    <SolidColorBrush x:Key="AppIconBrush" Color="#FFE0E0E0" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#FF3A3A3A" />
                    <SolidColorBrush x:Key="AppDividerBrush" Color="#25FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource AppIconBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
