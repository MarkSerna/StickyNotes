<Window
    x:Class="StickyNotes.App.Views.NoteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:enums="using:StickyNotes.Core.Enums"
    mc:Ignorable="d"
    Title="Nota Rápida">

    <Grid x:Name="RootGrid" CornerRadius="12" BorderThickness="1">
        <Grid.RowDefinitions>
            <!-- Cabecera de la nota (arrastre y controles) -->
            <RowDefinition Height="36"/>
            <!-- Área de texto enriquecido -->
            <RowDefinition Height="*"/>
            <!-- Barra inferior de formato de texto y auto-guardado -->
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- CABECERA SUPERIOR DE LA NOTA -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="6,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Acciones izquierdas: Nueva nota y Fijar (Pin) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button x:Name="BtnNewNote"
                        Click="BtnNewNote_Click"
                        ToolTipService.ToolTip="Nueva nota (+)"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="6,4">
                    <FontIcon x:Name="IconNewNote" Glyph="&#xE710;" FontSize="12"/>
                </Button>

                <ToggleButton x:Name="BtnPinTop"
                              Click="BtnPinTop_Click"
                              ToolTipService.ToolTip="Mantener siempre encima"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="6,4">
                    <FontIcon x:Name="IconPinTop" Glyph="&#xE718;" FontSize="12"/>
                </ToggleButton>
            </StackPanel>

            <!-- Título Editable de la Nota -->
            <TextBox x:Name="TxtTitle"
                     Grid.Column="1"
                     PlaceholderText="Título..."
                     BorderThickness="0"
                     Background="Transparent"
                     FontWeight="SemiBold"
                     FontSize="12"
                     VerticalAlignment="Center"
                     Margin="4,0"
                     TextWrapping="NoWrap"
                     TextChanged="TxtTitle_TextChanged"/>

            <!-- Acciones derechas: Sincronización, Paleta y Eliminar -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <!-- Indicador de Sincronización en la Cabecera -->
                <Border x:Name="BadgeSync" Padding="5,4" Background="Transparent" ToolTipService.ToolTip="Sincronizado con Google Drive">
                    <FontIcon x:Name="IconSync" Glyph="&#xE753;" FontSize="12"/>
                </Border>

                <!-- Selector de Color Flotante con Muestras Circulares -->
                <Button x:Name="BtnColorPicker"
                        ToolTipService.ToolTip="Colores de nota"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="6,4">
                    <FontIcon x:Name="IconPalette" Glyph="&#xE790;" FontSize="12"/>
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Orientation="Horizontal" Spacing="6" Padding="4">
                                <Button Width="24" Height="24" CornerRadius="12" Background="#FFF385" BorderBrush="#F6D83B" BorderThickness="1.5" ToolTipService.ToolTip="Amarillo clásico" Click="ColorItem_Click" Tag="Yellow" Padding="0"/>
                                <Button Width="24" Height="24" CornerRadius="12" Background="#D2F8B8" BorderBrush="#A2E278" BorderThickness="1.5" ToolTipService.ToolTip="Verde menta" Click="ColorItem_Click" Tag="Green" Padding="0"/>
                                <Button Width="24" Height="24" CornerRadius="12" Background="#FFCEE8" BorderBrush="#F389C3" BorderThickness="1.5" ToolTipService.ToolTip="Rosa pastel" Click="ColorItem_Click" Tag="Pink" Padding="0"/>
                                <Button Width="24" Height="24" CornerRadius="12" Background="#E7DCFF" BorderBrush="#BF9FFF" BorderThickness="1.5" ToolTipService.ToolTip="Morado lavanda" Click="ColorItem_Click" Tag="Purple" Padding="0"/>
                                <Button Width="24" Height="24" CornerRadius="12" Background="#CEECFE" BorderBrush="#8CCBF7" BorderThickness="1.5" ToolTipService.ToolTip="Azul cielo" Click="ColorItem_Click" Tag="Blue" Padding="0"/>
                                <Button Width="24" Height="24" CornerRadius="12" Background="#E9ECEF" BorderBrush="#CED4DA" BorderThickness="1.5" ToolTipService.ToolTip="Gris neutro" Click="ColorItem_Click" Tag="Gray" Padding="0"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Eliminar Nota -->
                <Button x:Name="BtnDelete"
                        Click="BtnDelete_Click"
                        ToolTipService.ToolTip="Eliminar nota"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="6,4">
                    <FontIcon x:Name="IconDelete" Glyph="&#xE74D;" FontSize="12"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- CUERPO PRINCIPAL: EDITOR DE TEXTO -->
        <RichEditBox x:Name="EditorBox"
                     Grid.Row="1"
                     Margin="10,4,10,4"
                     BorderThickness="0"
                     Background="Transparent"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     FontSize="13"
                     FontFamily="Segoe UI Variable Text, Segoe UI"
                     TextChanged="EditorBox_TextChanged"/>

        <!-- BARRA INFERIOR: FORMATO Y AUTO-GUARDADO -->
        <Grid x:Name="FooterBar" Grid.Row="2" Padding="8,2" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Herramientas de formato básico (Exacto a Microsoft Sticky Notes) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <ToggleButton x:Name="BtnBold" Click="BtnBold_Click" ToolTipService.ToolTip="Negrita (Ctrl+B)" Background="Transparent" BorderThickness="0" Padding="5,3">
                    <FontIcon x:Name="IconBold" Glyph="&#xE8DD;" FontSize="11"/>
                </ToggleButton>
                <ToggleButton x:Name="BtnItalic" Click="BtnItalic_Click" ToolTipService.ToolTip="Cursiva (Ctrl+I)" Background="Transparent" BorderThickness="0" Padding="5,3">
                    <FontIcon x:Name="IconItalic" Glyph="&#xE8DB;" FontSize="11"/>
                </ToggleButton>
                <ToggleButton x:Name="BtnUnderline" Click="BtnUnderline_Click" ToolTipService.ToolTip="Subrayado (Ctrl+U)" Background="Transparent" BorderThickness="0" Padding="5,3">
                    <FontIcon x:Name="IconUnderline" Glyph="&#xE8DC;" FontSize="11"/>
                </ToggleButton>
                <ToggleButton x:Name="BtnStrikethrough" Click="BtnStrikethrough_Click" ToolTipService.ToolTip="Tachado (Ctrl+T)" Background="Transparent" BorderThickness="0" Padding="5,3">
                    <FontIcon x:Name="IconStrikethrough" Glyph="&#xEDE0;" FontSize="11"/>
                </ToggleButton>
                <Button x:Name="BtnChecklist" Click="BtnChecklist_Click" ToolTipService.ToolTip="Lista de comprobación" Background="Transparent" BorderThickness="0" Padding="5,3">
                    <FontIcon x:Name="IconChecklist" Glyph="&#xE73A;" FontSize="11"/>
                </Button>
            </StackPanel>

            <!-- Leyenda sutil de Auto-guardado -->
            <TextBlock x:Name="TxtAutoSave"
                       Grid.Column="1"
                       Text="Auto-guardado 500ms"
                       FontSize="10"
                       Opacity="0.65"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"/>
        </Grid>
    </Grid>
</Window>