<ContentDialog
    x:Class="StickyNotes.App.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Configuración de Sincronización"
    PrimaryButtonText="Guardar"
    CloseButtonText="Cerrar"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <StackPanel Spacing="14" MinWidth="360" MaxWidth="440" Margin="0,8,0,0">
        <!-- Estado de la Cuenta -->
        <Border CornerRadius="8" Padding="12" Background="{ThemeResource AppSubtleSurfaceBrush}" BorderThickness="1" BorderBrush="{ThemeResource AppBorderBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <FontIcon x:Name="IconAuthStatus" Glyph="&#xE753;" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="DimGray"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="TxtAuthTitle" Text="Google Drive" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock x:Name="TxtAuthSubtitle" Text="No conectado" FontSize="11" Foreground="{ThemeResource AppSecondaryTextBrush}"/>
                </StackPanel>
                <Button x:Name="BtnConnectToggle" Grid.Column="2" Click="BtnConnectToggle_Click" Content="Conectar" FontSize="11" Padding="10,4"/>
            </Grid>
        </Border>

        <!-- Credenciales OAuth -->
        <StackPanel Spacing="10">
            <TextBlock Text="Credenciales de Google Cloud Console" FontWeight="SemiBold" FontSize="12"/>

            <TextBox x:Name="TxtClientId" Header="ID de cliente (Client ID)" PlaceholderText="xxxx.apps.googleusercontent.com" FontSize="12"/>
            <PasswordBox x:Name="TxtClientSecret" Header="Secreto de cliente (Client Secret)" PlaceholderText="GOCSPX-xxxx" FontSize="12"/>

            <TextBlock Text="• Scope restringido: drive.appdata (carpeta oculta propia, sin acceso a tus fotos ni documentos personales)." FontSize="10.5" Foreground="{ThemeResource AppSecondaryTextBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Mensaje de estado -->
        <TextBlock x:Name="TxtStatusMessage" FontSize="11" Foreground="DarkGoldenrod" TextWrapping="Wrap" Visibility="Collapsed"/>
    </StackPanel>
</ContentDialog>
