<Window
    x:Class="StickyNotes.App.Views.SideNotesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:StickyNotes.Core.Models"
    mc:Ignorable="d"
    Title="Panel Lateral de Notas">

    <Grid x:Name="RootLayout" RequestedTheme="Dark" Background="{x:Null}">
        <!-- PÍLDORA FLOTANTE COMPACTA EN EL BORDE CUANDO ESTÁ COLAPSADO (Solo donde están las notas) -->
        <Border x:Name="PeekingHandle"
                Width="16"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                CornerRadius="8,0,0,8"
                Background="#E60F172A"
                BorderThickness="1,1,0,1"
                BorderBrush="#334155"
                PointerEntered="PeekingHandle_PointerEntered"
                PointerExited="PeekingHandle_PointerExited"
                PointerPressed="PeekingHandle_PointerPressed"
                PointerMoved="PeekingHandle_PointerMoved"
                PointerReleased="PeekingHandle_PointerReleased"
                PointerCanceled="PeekingHandle_PointerReleased"
                ToolTipService.ToolTip="Notas rápidas (Pasa el cursor para abrir, o arrastra para mover de borde/pantalla)">
            <StackPanel x:Name="PeekingPillsStack"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="4"
                        Margin="0,4"/>
        </Border>

        <!-- CONTENEDOR PRINCIPAL DEL PANEL LATERAL EXPANDIDO (Imagen 3) -->
        <Grid x:Name="ExpandedPanel"
              Width="480"
              HorizontalAlignment="Right"
              Background="#F2090D16"
              BorderThickness="1,0,0,0"
              BorderBrush="#1E293B"
              PointerEntered="ExpandedPanel_PointerEntered"
              PointerExited="ExpandedPanel_PointerExited">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="PanelTransform" X="0"/>
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <!-- Tira de borde con píldoras de colores -->
                <ColumnDefinition x:Name="Col0" Width="18"/>
                <!-- Columna: Tarjeta Completa de la Nota Activa -->
                <ColumnDefinition x:Name="Col1" Width="*"/>
                <!-- Columna: Barra Lateral de Lista de Notas -->
                <ColumnDefinition x:Name="Col2" Width="140"/>
            </Grid.ColumnDefinitions>

            <!-- TIRA DE REPOSO INTEGRADA EN EL BORDE EXPANDIDO -->
            <Border x:Name="ExpandedPillsBorder"
                    Grid.Column="0"
                    Background="#D90F172A"
                    BorderThickness="0,0,1,0"
                    BorderBrush="#1E293B"
                    PointerPressed="BtnCollapse_Click"
                    ToolTipService.ToolTip="Haz clic para colapsar panel">
                <StackPanel x:Name="ExpandedPillsStack"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="4"/>
            </Border>

            <!-- COLUMNA PRINCIPAL: EDITOR DE LA NOTA SELECCIONADA -->
            <Grid x:Name="ActiveNoteContainer" Grid.Column="1" Margin="10,14,8,14">
                <!-- TARJETA ESTILO STICKY NOTE IDÉNTICA AL MODO FLOTANTE -->
                <Grid x:Name="ActiveNoteCard"
                      RequestedTheme="Light"
                      CornerRadius="12"
                      BorderThickness="1"
                      BorderBrush="#00000020"
                      VerticalAlignment="Top"
                      Height="240">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="12"/>
                    </Grid.RowDefinitions>

                    <!-- Cabecera de la Nota en el Panel Lateral con bordes redondeados superiores -->
                    <Border x:Name="NoteHeaderBar" Grid.Row="0" CornerRadius="11,11,0,0" Padding="10,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Título Editable -->
                            <TextBox x:Name="TxtActiveNoteTitle"
                                     Grid.Column="0"
                                     PlaceholderText="Título de la nota..."
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontWeight="Bold"
                                     FontSize="12"
                                     VerticalAlignment="Center"
                                     Margin="0,0,4,0"
                                 TextWrapping="NoWrap"
                                 TextChanged="TxtActiveNoteTitle_TextChanged">
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent"/>
                            </TextBox.Resources>
                        </TextBox>

                        <!-- Acciones: Sync, Opciones y Papelera -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <!-- Indicador de Sync -->
                            <Border x:Name="BadgeActiveSync" Padding="4" Background="Transparent" ToolTipService.ToolTip="Sincronizado con Google Drive">
                                <FontIcon x:Name="IconActiveSync" Glyph="&#xE753;" FontSize="11"/>
                            </Border>

                            <!-- Menú Contextual de Opciones (3 Puntos / MoreVertical) -->
                            <Button x:Name="BtnNoteMenu"
                                    ToolTipService.ToolTip="Opciones de la nota"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="5,4">
                                <FontIcon x:Name="IconActiveMore" Glyph="&#xE712;" FontSize="11"/>
                                <Button.Flyout>
                                    <Flyout Placement="Bottom">
                                        <StackPanel Spacing="8" Width="180" Padding="4">
                                            <TextBlock Text="COLORES DE NOTA" FontSize="9" FontWeight="Bold" Foreground="#64748B" CharacterSpacing="80"/>
                                            <Grid ColumnDefinitions="*,*,*,*,*,*" Margin="0,2">
                                                <Button Grid.Column="0" Width="20" Height="20" CornerRadius="10" Background="#FFF385" BorderBrush="#F6D83B" BorderThickness="1.5" Click="SetColor_Click" Tag="Yellow" Padding="0" ToolTipService.ToolTip="Amarillo"/>
                                                <Button Grid.Column="1" Width="20" Height="20" CornerRadius="10" Background="#D2F8B8" BorderBrush="#A2E278" BorderThickness="1.5" Click="SetColor_Click" Tag="Green" Padding="0" ToolTipService.ToolTip="Verde"/>
                                                <Button Grid.Column="2" Width="20" Height="20" CornerRadius="10" Background="#FFCEE8" BorderBrush="#F389C3" BorderThickness="1.5" Click="SetColor_Click" Tag="Pink" Padding="0" ToolTipService.ToolTip="Rosa"/>
                                                <Button Grid.Column="3" Width="20" Height="20" CornerRadius="10" Background="#E7DCFF" BorderBrush="#BF9FFF" BorderThickness="1.5" Click="SetColor_Click" Tag="Purple" Padding="0" ToolTipService.ToolTip="Morado"/>
                                                <Button Grid.Column="4" Width="20" Height="20" CornerRadius="10" Background="#CEECFE" BorderBrush="#8CCBF7" BorderThickness="1.5" Click="SetColor_Click" Tag="Blue" Padding="0" ToolTipService.ToolTip="Azul"/>
                                                <Button Grid.Column="5" Width="20" Height="20" CornerRadius="10" Background="#E9ECEF" BorderBrush="#CED4DA" BorderThickness="1.5" Click="SetColor_Click" Tag="Gray" Padding="0" ToolTipService.ToolTip="Gris"/>
                                            </Grid>
                                            <MenuFlyoutSeparator Margin="0,2"/>
                                            <Button Click="BtnFloatSingleNote_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="6,4">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE737;" FontSize="11"/>
                                                    <TextBlock Text="Abrir ventana flotante" FontSize="11"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Click="BtnDuplicateSingleNote_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="6,4">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="11"/>
                                                    <TextBlock Text="Duplicar nota" FontSize="11"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Click="BtnExportActiveMarkdown_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="6,4">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xEDE1;" FontSize="11"/>
                                                    <TextBlock Text="Exportar a Markdown" FontSize="11"/>
                                                </StackPanel>
                                            </Button>
                                            <MenuFlyoutSeparator Margin="0,2"/>
                                            <TextBlock Text="GRADUAR TAMAÑO" FontSize="9" FontWeight="Bold" Foreground="#64748B" CharacterSpacing="80"/>
                                            <Grid ColumnDefinitions="*,*,*,*" Margin="0,2">
                                                <Button Grid.Column="0" Content="260" ToolTipService.ToolTip="Compacto (260 px)" FontSize="10" Click="SetNoteSize_Click" Tag="260" Padding="0" Height="24" HorizontalAlignment="Stretch" Margin="1,0"/>
                                                <Button Grid.Column="1" Content="340" ToolTipService.ToolTip="Mediano (340 px)" FontSize="10" Click="SetNoteSize_Click" Tag="340" Padding="0" Height="24" HorizontalAlignment="Stretch" Margin="1,0"/>
                                                <Button Grid.Column="2" Content="500" ToolTipService.ToolTip="Grande (500 px)" FontSize="10" Click="SetNoteSize_Click" Tag="500" Padding="0" Height="24" HorizontalAlignment="Stretch" Margin="1,0"/>
                                                <Button Grid.Column="3" Content="Max" ToolTipService.ToolTip="Pantalla completa" FontSize="10" Click="SetNoteSize_Click" Tag="0" Padding="0" Height="24" HorizontalAlignment="Stretch" Margin="1,0"/>
                                            </Grid>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <!-- Eliminar Nota -->
                            <Button x:Name="BtnDeleteActiveNote"
                                    Click="BtnDeleteActiveNote_Click"
                                    ToolTipService.ToolTip="Eliminar nota"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="5,4">
                                <FontIcon x:Name="IconActiveDelete" Glyph="&#xE74D;" FontSize="11"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Cuerpo: Editor de Texto -->
                <RichEditBox x:Name="ActiveNoteEditor"
                             Grid.Row="1"
                             Margin="10,4,10,4"
                             BorderThickness="0"
                             Background="Transparent"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             FontSize="13"
                             FontFamily="Segoe UI Variable Text, Segoe UI"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             TextChanged="ActiveNoteEditor_TextChanged">
                    <RichEditBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent"/>
                    </RichEditBox.Resources>
                </RichEditBox>

                <!-- Pie: Barra de Formato y Auto-guardado -->
                <Border x:Name="ActiveNoteFooter" Grid.Row="2" Padding="8,2" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Herramientas B, I, U, S, Viñetas -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <ToggleButton Click="BtnBold_Click" ToolTipService.ToolTip="Negrita (Ctrl+B)" Background="Transparent" BorderThickness="0" Padding="5,3">
                                <FontIcon x:Name="IconActiveBold" Glyph="&#xE8DD;" FontSize="11"/>
                            </ToggleButton>
                            <ToggleButton Click="BtnItalic_Click" ToolTipService.ToolTip="Cursiva (Ctrl+I)" Background="Transparent" BorderThickness="0" Padding="5,3">
                                <FontIcon x:Name="IconActiveItalic" Glyph="&#xE8DB;" FontSize="11"/>
                            </ToggleButton>
                            <ToggleButton Click="BtnUnderline_Click" ToolTipService.ToolTip="Subrayado (Ctrl+U)" Background="Transparent" BorderThickness="0" Padding="5,3">
                                <FontIcon x:Name="IconActiveUnderline" Glyph="&#xE8DC;" FontSize="11"/>
                            </ToggleButton>
                            <ToggleButton Click="BtnStrikethrough_Click" ToolTipService.ToolTip="Tachado (Ctrl+T)" Background="Transparent" BorderThickness="0" Padding="5,3">
                                <FontIcon x:Name="IconActiveStrikethrough" Glyph="&#xEDE0;" FontSize="11"/>
                            </ToggleButton>
                            <Button Click="BtnChecklist_Click" ToolTipService.ToolTip="Lista de comprobación" Background="Transparent" BorderThickness="0" Padding="5,3">
                                <FontIcon x:Name="IconActiveChecklist" Glyph="&#xE73A;" FontSize="11"/>
                            </Button>
                        </StackPanel>

                        <!-- Leyenda de auto-guardado (oculta) -->
                        <TextBlock x:Name="TxtActiveAutoSave"
                                   Grid.Column="1"
                                   Text="Auto-guardado 500ms"
                                   Visibility="Collapsed"
                                   FontSize="10"
                                   Opacity="0.65"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                    </Grid>
                </Border>

                    <!-- Manija de redimensionamiento para graduar el tamaño vertical de la nota -->
                    <Border x:Name="ResizeGrip"
                            Grid.Row="3"
                            Height="12"
                            Background="Transparent"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Stretch"
                            PointerPressed="ResizeGrip_PointerPressed"
                            PointerMoved="ResizeGrip_PointerMoved"
                            PointerReleased="ResizeGrip_PointerReleased"
                            PointerCanceled="ResizeGrip_PointerReleased"
                            ToolTipService.ToolTip="Arrastra para graduar la altura de la nota">
                        <Border Width="36"
                                Height="3"
                                CornerRadius="1.5"
                                Background="#00000030"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Grid>

            <!-- COLUMNA: LISTA DE PESTAÑAS 'NOTAS' (Imagen 3) -->
            <Grid x:Name="NotesSidebarContainer" Grid.Column="2" Background="#020617" BorderThickness="1,0,0,0" BorderBrush="#1E293B">
                <Grid.RowDefinitions>
                    <!-- Cabecera de la columna 'NOTAS' -->
                    <RowDefinition Height="36"/>
                    <!-- Buscador -->
                    <RowDefinition Height="34"/>
                    <!-- Lista de Notas -->
                    <RowDefinition Height="*"/>
                    <!-- Botón + Nueva -->
                    <RowDefinition Height="46"/>
                </Grid.RowDefinitions>

                <!-- Cabecera NOTAS con Pin y Acciones -->
                <Grid Grid.Row="0" Padding="8,2" BorderThickness="0,0,0,1" BorderBrush="#1E293B">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="NOTAS"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#94A3B8"
                               VerticalAlignment="Center"
                               CharacterSpacing="100"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <ToggleButton x:Name="BtnPin" Click="BtnPin_Click" ToolTipService.ToolTip="Fijar panel abierto permanentemente" Background="Transparent" BorderThickness="0" Padding="5,3">
                            <FontIcon Glyph="&#xE718;" FontSize="11" Foreground="#94A3B8"/>
                        </ToggleButton>
                        <ToggleButton x:Name="BtnToggleTrash" Click="BtnToggleTrash_Click" ToolTipService.ToolTip="Papelera" Background="Transparent" BorderThickness="0" Padding="5,3">
                            <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="#94A3B8"/>
                        </ToggleButton>
                        <Button x:Name="BtnPositionMenu" ToolTipService.ToolTip="Posición y Pantallas" Background="Transparent" BorderThickness="0" Padding="5,3">
                            <FontIcon Glyph="&#xE740;" FontSize="11" Foreground="#94A3B8"/>
                            <Button.Flyout>
                                <MenuFlyout x:Name="PositionFlyout" Opening="PositionFlyout_Opening">
                                    <MenuFlyoutItem x:Name="MenuToggleEdge" Text="Mover al borde izquierdo" Click="MenuToggleEdge_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE765;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator x:Name="MenuMonitorsSeparator"/>
                                    <MenuFlyoutSubItem x:Name="MenuMonitorsSubItem" Text="Mover a otra pantalla">
                                        <MenuFlyoutSubItem.Icon>
                                            <FontIcon Glyph="&#xE7F4;"/>
                                        </MenuFlyoutSubItem.Icon>
                                    </MenuFlyoutSubItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button Click="BtnSettings_Click" ToolTipService.ToolTip="Configuración Google Drive" Background="Transparent" BorderThickness="0" Padding="5,3">
                            <FontIcon Glyph="&#xE713;" FontSize="11" Foreground="#94A3B8"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Buscador Rápido -->
                <AutoSuggestBox x:Name="SearchBox"
                                Grid.Row="1"
                                Margin="6,2"
                                PlaceholderText="Buscar..."
                                QueryIcon="Find"
                                TextChanged="SearchBox_TextChanged"
                                FontSize="11"
                                Height="28"/>

                <!-- Lista Vertical de Notas -->
                <ListView x:Name="NotesTabList"
                          Grid.Row="2"
                          SelectionMode="Single"
                          SelectionChanged="NotesTabList_SelectionChanged"
                          Padding="4,2">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Note">
                            <Border CornerRadius="8"
                                    Padding="6,5"
                                    Margin="0,2"
                                    BorderThickness="1"
                                    BorderBrush="#1E293B"
                                    Background="#0F172A">
                                <Grid RowDefinitions="Auto,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="{x:Bind ColorHex, Mode=OneWay}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind DisplayTitle}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#E2E8F0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1"
                                               Text="{x:Bind PreviewText, Mode=OneWay}"
                                               FontSize="9"
                                               Foreground="#94A3B8"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1"
                                               Margin="13,2,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Botón + Nueva (Exacto al diseño de la Imagen 3) -->
                <Border Grid.Row="3" Padding="6,4,6,6" BorderThickness="0,1,0,0" BorderBrush="#1E293B">
                    <Button Click="BtnNewNote_Click"
                            HorizontalAlignment="Stretch"
                            Height="32"
                            CornerRadius="6"
                            Background="Transparent"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            ToolTipService.ToolTip="Nueva nota (+)">
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE710;" FontSize="11" Foreground="#94A3B8"/>
                            <TextBlock Text="Nueva" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>