<UserControl
    x:Class="StickyNotes.App.Views.NoteCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:StickyNotes.Core.Models"
    mc:Ignorable="d">

    <Grid x:Name="CardRoot"
          RequestedTheme="Light"
          CornerRadius="12"
          BorderThickness="1"
          BorderBrush="#00000020"
          VerticalAlignment="Top"
          Height="200"
          PointerPressed="CardRoot_PointerPressed">
        <Grid.RowDefinitions>
            <!-- Fila 0: Cabecera -->
            <RowDefinition Height="38"/>
            <!-- Fila 1: Editor de Texto -->
            <RowDefinition Height="*"/>
            <!-- Fila 2: Barra de Formato Inferior -->
            <RowDefinition Height="34"/>
            <!-- Fila 3: Grip de Arrastre/Tamaño -->
            <RowDefinition Height="12"/>
        </Grid.RowDefinitions>

        <!-- Cabecera de la Nota con bordes redondeados superiores -->
        <Border x:Name="HeaderBar" Grid.Row="0" CornerRadius="11,11,0,0" Padding="10,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Título Editable in-place -->
                <TextBox x:Name="TxtTitle"
                         Grid.Column="0"
                         PlaceholderText="Título de la nota..."
                         Background="Transparent"
                         BorderThickness="0"
                         FontWeight="Bold"
                         FontSize="12"
                         VerticalAlignment="Center"
                         Margin="0,0,4,0"
                         TextWrapping="NoWrap"
                         TextChanged="TxtTitle_TextChanged">
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent"/>
                    </TextBox.Resources>
                </TextBox>

                <!-- Acciones: Sync, Opciones y Papelera -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <!-- Indicador de Sync -->
                    <Border x:Name="BadgeSync" Padding="4" Background="Transparent" ToolTipService.ToolTip="Sincronizado con Google Drive">
                        <FontIcon x:Name="IconSync" Glyph="&#xE753;" FontSize="11"/>
                    </Border>

                    <!-- Menú Contextual de Opciones (3 Puntos) -->
                    <Button x:Name="BtnMenu"
                            ToolTipService.ToolTip="Opciones de la nota"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="5,4">
                        <FontIcon x:Name="IconMore" Glyph="&#xE712;" FontSize="11"/>
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <StackPanel Spacing="8" Width="180" Padding="4">
                                    <TextBlock Text="COLORES DE NOTA" FontSize="9" FontWeight="Bold" Foreground="#64748B" CharacterSpacing="80"/>
                                    <Grid ColumnDefinitions="*,*,*,*,*,*" Margin="0,2">
                                        <Button Grid.Column="0" Width="20" Height="20" CornerRadius="10" Background="#FFF385" BorderBrush="#F6D83B" BorderThickness="1.5" Click="SetColor_Click" Tag="Yellow" Padding="0" ToolTipService.ToolTip="Amarillo"/>
                                        <Button Grid.Column="1" Width="20" Height="20" CornerRadius="10" Background="#D2F8B8" BorderBrush="#A2E278" BorderThickness="1.5" Click="SetColor_Click" Tag="Green" Padding="0" ToolTipService.ToolTip="Verde"/>
                                        <Button Grid.Column="2" Width="20" Height="20" CornerRadius="10" Background="#FFCEE8" BorderBrush="#F389C3" BorderThickness="1.5" Click="SetColor_Click" Tag="Pink" Padding="0" ToolTipService.ToolTip="Rosa"/>
                                        <Button Grid.Column="3" Width="20" Height="20" CornerRadius="10" Background="#E7DCFF" BorderBrush="#BF9FFF" BorderThickness="1.5" Click="SetColor_Click" Tag="Purple" Padding="0" ToolTipService.ToolTip="Morado"/>
                                        <Button Grid.Column="4" Width="20" Height="20" CornerRadius="10" Background="#CEECFE" BorderBrush="#8CCBF7" BorderThickness="1.5" Click="SetColor_Click" Tag="Blue" Padding="0" ToolTipService.ToolTip="Azul"/>
                                        <Button Grid.Column="5" Width="20" Height="20" CornerRadius="10" Background="#E9ECEF" BorderBrush="#CED4DA" BorderThickness="1.5" Click="SetColor_Click" Tag="Gray" Padding="0" ToolTipService.ToolTip="Gris"/>
                                    </Grid>
                                    <MenuFlyoutSeparator Margin="0,2"/>
                                    <Button Click="BtnFloatSingleNote_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="6,4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE737;" FontSize="11"/>
                                            <TextBlock Text="Abrir ventana flotante" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="BtnDuplicateSingleNote_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="6,4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="11"/>
                                            <TextBlock Text="Duplicar nota" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="BtnExportActiveMarkdown_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="6,4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xEDE1;" FontSize="11"/>
                                            <TextBlock Text="Exportar a Markdown" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                    <MenuFlyoutSeparator Margin="0,2"/>
                                    <TextBlock Text="GRADUAR TAMAÑO" FontSize="9" FontWeight="Bold" Foreground="#64748B" CharacterSpacing="80"/>
                                    <Grid ColumnDefinitions="*,*,*,*" Margin="0,2">
                                        <Button Grid.Column="0" Content="200" ToolTipService.ToolTip="Compacto (200 px)" FontSize="10" Click="SetNoteSize_Click" Tag="200" Padding="0" Height="24" HorizontalAlignment="Stretch" Margin="1,0"/>
                                        <Button Grid.Column="1" Content="300" ToolTipService.ToolTip="Mediano (300 px)" FontSize="10" Click="SetNoteSize_Click" Tag="300" Padding="0" Height="24" HorizontalAlignment="Stretch" Margin="1,0"/>
                                        <Button Grid.Column="2" Content="450" ToolTipService.ToolTip="Grande (450 px)" FontSize="10" Click="SetNoteSize_Click" Tag="450" Padding="0" Height="24" HorizontalAlignment="Stretch" Margin="1,0"/>
                                        <Button Grid.Column="3" Content="Auto" ToolTipService.ToolTip="Ajuste automático según texto" FontSize="10" Click="SetNoteSize_Click" Tag="0" Padding="0" Height="24" HorizontalAlignment="Stretch" Margin="1,0"/>
                                    </Grid>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Eliminar Nota -->
                    <Button x:Name="BtnDelete"
                            Click="BtnDelete_Click"
                            ToolTipService.ToolTip="Eliminar nota"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="5,4">
                        <FontIcon x:Name="IconDelete" Glyph="&#xE74D;" FontSize="11"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Cuerpo: Editor de Texto Enriquecido -->
        <RichEditBox x:Name="EditorBox"
                     Grid.Row="1"
                     Margin="10,4,10,4"
                     BorderThickness="0"
                     Background="Transparent"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     FontSize="13"
                     FontFamily="Segoe UI Variable Text, Segoe UI"
                     VerticalAlignment="Stretch"
                     VerticalContentAlignment="Top"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     TextChanged="EditorBox_TextChanged"
                     GotFocus="EditorBox_GotFocus">
            <RichEditBox.Resources>
                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/>
                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent"/>
            </RichEditBox.Resources>
        </RichEditBox>

        <!-- Pie: Barra de Formato Inferior -->
        <Border x:Name="FooterBar" Grid.Row="2" Padding="8,2" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Herramientas B, I, U, S, Viñetas -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <ToggleButton Click="BtnBold_Click" ToolTipService.ToolTip="Negrita (Ctrl+B)" Background="Transparent" BorderThickness="0" Padding="5,3">
                        <FontIcon x:Name="IconBold" Glyph="&#xE8DD;" FontSize="11"/>
                    </ToggleButton>
                    <ToggleButton Click="BtnItalic_Click" ToolTipService.ToolTip="Cursiva (Ctrl+I)" Background="Transparent" BorderThickness="0" Padding="5,3">
                        <FontIcon x:Name="IconItalic" Glyph="&#xE8DB;" FontSize="11"/>
                    </ToggleButton>
                    <ToggleButton Click="BtnUnderline_Click" ToolTipService.ToolTip="Subrayado (Ctrl+U)" Background="Transparent" BorderThickness="0" Padding="5,3">
                        <FontIcon x:Name="IconUnderline" Glyph="&#xE8DC;" FontSize="11"/>
                    </ToggleButton>
                    <ToggleButton Click="BtnStrikethrough_Click" ToolTipService.ToolTip="Tachado (Ctrl+T)" Background="Transparent" BorderThickness="0" Padding="5,3">
                        <FontIcon x:Name="IconStrikethrough" Glyph="&#xEDE0;" FontSize="11"/>
                    </ToggleButton>
                    <Button Click="BtnChecklist_Click" ToolTipService.ToolTip="Lista de comprobación" Background="Transparent" BorderThickness="0" Padding="5,3">
                        <FontIcon x:Name="IconChecklist" Glyph="&#xE73A;" FontSize="11"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Manija de redimensionamiento para graduar el tamaño vertical de la nota -->
        <Border x:Name="ResizeGrip"
                Grid.Row="3"
                Height="12"
                Background="Transparent"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                PointerPressed="ResizeGrip_PointerPressed"
                PointerMoved="ResizeGrip_PointerMoved"
                PointerReleased="ResizeGrip_PointerReleased"
                PointerCanceled="ResizeGrip_PointerReleased"
                ToolTipService.ToolTip="Arrastra para graduar la altura de esta nota">
            <Border Width="36"
                    Height="3"
                    CornerRadius="1.5"
                    Background="#00000030"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
